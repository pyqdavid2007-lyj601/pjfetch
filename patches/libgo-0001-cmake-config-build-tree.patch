diff --git a/CMakeLists.txt b/CMakeLists.txt
index 0c6303e..4cc7156 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -47,7 +47,9 @@ message("  CMAKE_SOURCE_DIR: ${CMAKE_SOURCE_DIR}")
 message("  CMAKE_BINARY_DIR: ${CMAKE_BINARY_DIR}")
 message("----------------------------------")
 
-configure_file(${PROJECT_SOURCE_DIR}/libgo/common/cmake_config.h.in ${PROJECT_SOURCE_DIR}/libgo/common/cmake_config.h)
+# pjfetch vendor patch: write generated cmake_config.h into the build tree so
+# multiple build trees (msvc-release/msvc-debug/linux) don't clobber each other.
+configure_file(${PROJECT_SOURCE_DIR}/libgo/common/cmake_config.h.in ${CMAKE_BINARY_DIR}/generated/libgo/common/cmake_config.h)
 message("----------------------------------")
 
 if (UNIX)
@@ -78,6 +80,10 @@ message("------------ Cxx flags -------------")
 message("  CMAKE_CXX_FLAGS_${CMAKE_BUILD_TYPE}: ${CMAKE_CXX_FLAGS_${CMAKE_BUILD_TYPE}}")
 message("------------------------------------")
 
+# pjfetch vendor patch: prefer the build-tree generated header (see configure_file above).
+# The dir must be .../generated/libgo/common because libgo/common/config.h includes
+# the bare filename "cmake_config.h" (quoted include = basename search in each -I dir).
+include_directories(BEFORE ${CMAKE_BINARY_DIR}/generated/libgo/common)
 include_directories(${PROJECT_SOURCE_DIR})
 aux_source_directory(${PROJECT_SOURCE_DIR}/libgo CO_SRC_LIST)
 aux_source_directory(${PROJECT_SOURCE_DIR}/libgo/common CO_SRC_LIST)
